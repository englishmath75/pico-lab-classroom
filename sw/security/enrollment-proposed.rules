        'sw3-2026-g2-avatar-python',
        'sw3-2026-g2-datalab-sw01-1',
        'sw3-2026-g2-datalab-sw01-2',
        'sw3-2026-g2-datalab-sw03-1',
        'sw3-2026-g2-datalab-sw03-2',
        'sw3-2026-g2-datalab-sw04-1',
        'sw3-2026-g2-datalab-sw04-2',
        'sw2-inquiry-d-state',
        'sw2-kosis',
        'sw2-lesson-01-state',
        'sw2-lesson-02-state',
        'sw2-lesson-03-state',
        'sw2-lesson-04-state',
        'sw2-lesson-05-state',
        'sw2-lesson-06-state',
        'sw2-lesson-07-state',
        'sw2-lesson-08-state',
        'sw2-lesson-09-state',
        'sw2-lesson-10-state',
        'sw2-review',
        'sw2-report',
        'sw2-basics',
        'sw2-binary',
        'sw2-first-analysis',
        'sw2-simulation',
        'sw2-free-code',
        'sw2-free-state',
        'sw2-archive-01',
        'sw2-archive2-01',
        'sw2-archive-02',
