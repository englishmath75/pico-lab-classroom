{
  "version": 2,
  "rewrites": [
    {
      "source": "/videos/:path*",
      "destination": "https://sw.englishmath.kr/videos/:path*"
    },
    {
      "source": "/learning-videos/:path*",
      "destination": "https://sw.englishmath.kr/learning-videos/:path*"
    },
    {
      "source": "/pandas-data-lab/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/avatar-vendor/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
