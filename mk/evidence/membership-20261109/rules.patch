+        && e.version == b.get('membershipVersion',0)+1 && id == string(e.version)
+        && a.membershipVersion == e.version && a.updatedAt == request.time
+        && e.before == b && e.after == a && e.actorUid == request.auth.uid && e.at == request.time;
+    }
