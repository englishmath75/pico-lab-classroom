+    // MK membership: versioned, atomic audit; SW users and public_users are unchanged.
+    function mkMemberFields(d) {
+      return d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 80;
+    }
+    function mkMemberReview(b,a,uid,teacher) {
+      let r = b.changeRequest;
+      let n = a.changeRequest;
+      return b.status in ['pending','approved'] && r.status == 'pending'
+        && n.diff(r).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy','note'])
+        && n.reviewedAt == request.time && n.reviewedBy == request.auth.uid
+        && n.note is string && n.note.size() <= 300
+        && ((teacher && n.status in ['approved','rejected']) || (own(uid) && n.status == 'withdrawn'))
+        && ((n.status == 'approved' && a.displayName == r.displayName && a.classId == r.classId)
+          || (n.status != 'approved' && a.displayName == b.displayName && a.classId == b.classId));
+    }
+    function mkMemberChange(uid,teacher,validClass,e) {
+      let b = resource.data;
+      let a = request.resource.data;
+      return validClass && mkMemberFields(a)
+        && a.diff(b).affectedKeys().hasOnly(['membershipVersion','updatedAt','changeRequest','displayName','classId','status'])
+        && a.membershipVersion is int && a.membershipVersion == b.get('membershipVersion',0)+1
+        && a.updatedAt == request.time
+        && e.before == b && e.after == a && e.actorUid == request.auth.uid && e.at == request.time
+        && ((e.action == 'request' && own(uid) && allowedEmail()
+              && b.status in ['pending','approved']
+              && (b.get('changeRequest',null) == null || b.changeRequest.status != 'pending')
+              && a.status == b.status && a.displayName == b.displayName && a.classId == b.classId
+              && a.changeRequest.keys().hasOnly(['displayName','classId','status','requestedAt'])
+              && mkMemberFields(a.changeRequest) && a.changeRequest.status == 'pending'
+              && a.changeRequest.requestedAt == request.time
+              && (a.changeRequest.displayName != b.displayName || a.changeRequest.classId != b.classId))
+          || (e.action in ['approve','reject','withdraw'] && a.status == b.status
+              && mkMemberReview(b,a,uid,teacher)
+              && ((e.action == 'approve' && a.changeRequest.status == 'approved')
+                || (e.action == 'reject' && a.changeRequest.status == 'rejected')
+                || (e.action == 'withdraw' && a.changeRequest.status == 'withdrawn')))
+          || (e.action == 'reapply' && own(uid) && allowedEmail() && b.status == 'cancelled'
+              && a.status == 'pending' && a.changeRequest == null)
+          || (e.action in ['status','cancel'] && teacher && a.displayName == b.displayName && a.classId == b.classId
+              && a.status in ['pending','approved','blocked','cancelled'] && a.status != b.status
+              && a.changeRequest == null && (e.action != 'cancel' || a.status == 'cancelled')));
+    }
+    function mkMemberHistory(path,id) {
+      let e = request.resource.data;
+      let b = get(path).data;
